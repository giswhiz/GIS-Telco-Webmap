erical character  \n","    if re.match(r'^\\d', name):  \n","        name = 'a_' + name  \n","    \n","    return name\n","\n","# Step 3: Clear all old .js files in the output directory  \n","for f in os.listdir(output_dir):  \n","    if f.endswith('.js'):  \n","        os.remove(os.path.join(output_dir, f))\n","\n","# Step 4: Group by 'anbieter_BBA' (company name) and create JavaScript files for each company  \n","for anbieter, group in df.groupby('anbieter_BBA'):  \n","    features = []  \n","    \n","    # Iterate over each row in the group (each company)  \n","    for _, row in group.iterrows():  \n","        feature = {  \n","            \"type\": \"Feature\",  \n","            \"properties\": {  \n","                \"fid\": int(row.name),  # Unique identifier (could use index or another unique column)  \n","                \"AGS\": row['AGS'],  \n","                \"GEN\": row['GEN'],  \n","                \"Anbietername\": row['anbieter_BBA'],  \n","                \"tku_id\": row['tku_id']  \n","            },  \n","            # Convert the geometry field from a JSON string into a proper dictionary  \n","            \"geometry\": json.loads(row['geometry'])  \n","        }  \n","        features.append(feature)  \n","    \n","    # Construct GeoJSON structure  \n","    geojson = {  \n","        \"type\": \"FeatureCollection\",  \n","        \"name\": anbieter,  # Using the original company name as the 'name' field for the legend  \n","        \"crs\": {  \n","            \"type\": \"name\",  \n","            \"properties\": {  \n","                \"name\": \"urn:ogc:def:crs:OGC:1.3:CRS84\"  # Common GeoJSON coordinate reference system  \n","            }  \n","        },  \n","        \"features\": features  \n","    }  \n","    \n","    # Write the GeoJSON to a JavaScript file  \n","    js_content = f\"var json_{sanitize_filename(anbieter)} = {json.dumps(geojson)};\"  \n","    js_filename = os.path.join(output_dir, f\"{sanitize_filename(anbieter)}.js\")  \n","    \n","    with open(js_filename, 'w', encoding='utf-8') as js_file:  \n","        js_file.write(js_content)\n","\n","print(f\"JavaScript files saved in: {os.path.abspath(output_dir)}\")\n","\n","#################################\n","\n","# HTML update process\n","html_template_path = r'C:\\Users\\xx\\Documents\\GitHub_MyRepo\\GIS-Portfolio\\Telco_Web_Map\\Visualisierung Ausbaukommunen.html'\n","output_html_path = r'C:\\Users\\xx\\Documents\\GitHub_MyRepo\\GIS-Portfolio\\Telco_Web_Map\\aktualisierte_Kommunen.html'\n","data_folder = r'C:\\Users\\xx\\Documents\\GitHub_MyRepo\\GIS-Portfolio\\Telco_Web_Map\\data'\n","\n","# Function to generate a random color in RGBA format  \n","def random_color():  \n","    import random\n","    return f\"rgba({random.randint(0, 255)}, {random.randint(0, 255)}, {random.randint(0, 255)}, 1.0)\"\n","\n","# Step 5: Read the existing HTML file  \n","with open(html_template_path, 'r', encoding='utf-8') as file:  \n","    html_content = file.read()\n","\n","# Step 6: Gather all company files from the \"data\" folder (excluding static layers)  \n","company_files = [f for f in os.listdir(data_folder) if f.endswith('.js') and f not in [  \n","    \"Bundeslndergrenzen_2020_23.js\", \"VG250_KRS_24.js\", \"VG250_32632_25.js\"]]\n","\n","# Prepare the new content to inject  \n","script_declarations = \"\\n\".join([f\"var json_{os.path.splitext(f)[0]} = null;\" for f in company_files])  \n","script_includes = \"\\n\".join([f'<script src=\"data/{f}\"></script>' for f in company_files])  \n","\n","layer_functions = \"\"  \n","layer_controls = \"\"  \n","for idx, file_name in enumerate(company_files):  \n","    company_var = os.path.splitext(file_name)[0]  \n","    layer_color = random_color()  \n","    fill_color = random_color()  \n","\n","    layer_functions += f\"\"\"\\nfunction style_{company_var}_{idx}() {{\n","    return {{\n","        pane: 'pane_{company_var}',\n","        opacity: 1,\n","        color: 'black',\n","        dashArray: '',\n","        lineCap: 'round',\n","        lineJoin: 'round',\n","        weight: 0.3,\n","        fill: true,\n","        fillOpacity: 0.5,\n","        fillColor: '{fill_color}',\n","        interactive: false,\n","    }};\n","}}\n","map.createPane('pane_{company_var}');\n","map.getPane('pane_{company_var}').style.zIndex = {400 + idx};\n","var layer_{company_var} = new L.geoJson(json_{company_var}, {{\n","    attribution: '',\n","    interactive: false,\n","    dataVar: 'json_{company_var}',\n","    layerName: 'layer_{company_var}',\n","    pane: 'pane_{company_var}',\n","    style: style_{company_var}_{idx},\n","}});\"\"\"\n","\n","    # Generate the display name by removing the prefix \"a_\" and replacing underscores with spaces  \n","    display_name = company_var.replace(\"a_\", \"\", 1).replace(\"_\", \" \")  \n","    layer_controls += f'layerControl.addOverlay(layer_{company_var}, \"{display_name}\", \"TKU FTTB/H IST\");\\n'  \n","\n","# Step 7: Update HTML content with new content using placeholders with start and end markers  \n","new_data = {  \n","    'script_declarations': script_declarations,  \n","    'script_includes': script_includes,  \n","    'layer_functions': layer_functions,  \n","    'layer_controls': layer_controls  \n","}\n","\n","# Define regex patterns with start and end markers for each section  \n","patterns = {  \n","    'script_declarations': re.compile(r'//PLACEHOLDER_SCRIPT_DECLARATIONS.*?//END_PLACEHOLDER_SCRIPT_DECLARATIONS', re.DOTALL),  \n","    'script_includes': re.compile(r'<!--PLACEHOLDER_SCRIPT_INCLUDES-->.*?<!--END_PLACEHOLDER_SCRIPT_INCLUDES-->', re.DOTALL),  \n","    'layer_functions': re.compile(r'//PLACEHOLDER_LAYER_FUNCTIONS.*?//END_PLACEHOLDER_LAYER_FUNCTIONS', re.DOTALL),  \n","    'layer_controls': re.compile(r'//PLACEHOLDER_LAYER_CONTROLS.*?//END_PLACEHOLDER_LAYER_CONTROLS', re.DOTALL)  \n","}\n","\n","# Replace each section in the HTML content with the new content  \n","html_content = re.sub(patterns['script_declarations'], f'//PLACEHOLDER_SCRIPT_DECLARATIONS\\n{new_data[\"script_declarations\"]}\\n//END_PLACEHOLDER_SCRIPT_DECLARATIONS', html_content)  \n","html_content = re.sub(patterns['script_includes'], f'<!--PLACEHOLDER_SCRIPT_INCLUDES-->\\n{new_data[\"script_includes\"]}\\n<!--END_PLACEHOLDER_SCRIPT_INCLUDES-->', html_content)  \n","html_content = re.sub(patterns['layer_functions'], f'//PLACEHOLDER_LAYER_FUNCTIONS\\n{new_data[\"layer_functions\"]}\\n//END_PLACEHOLDER_LAYER_FUNCTIONS', html_content)  \n","html_content = re.sub(patterns['layer_controls'], f'//PLACEHOLDER_LAYER_CONTROLS\\n{new_data[\"layer_controls\"]}\\n//END_PLACEHOLDER_LAYER_CONTROLS', html_content)  \n","\n","# Step 8: Save the updated HTML file  \n","with open(output_html_path, 'w', encoding='utf-8') as file:  \n","    file.write(html_content)  \n","    \n","print(\"HTML file updated successfully.\")\n","\n"],"execution_count":2,"outputs":[]},{"metadata":{"scrolled":true},"cell_type":"code","source":[],"execution_count":3,"outputs":[]}],"metadata":{"kernelspec":{"name":"designerbasetools_venv","display_name":"designerbasetools_venv","language":"python"},"language_info":{"name":"python","version":"3.10.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"}},"nbformat":4,"nbformat_minor":2}]]></Notebook>
